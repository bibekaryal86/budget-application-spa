{
  "name": "petssvc-fullstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "description": "UI and BFF in one project",
  "scripts": {
    "dev": "run-p dev:backend dev:frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "run-p build:backend build:frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "prettier": "prettier --check .",
    "prettier:write": "prettier --write .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "npm run type-check --prefix backend && npm run type-check --prefix frontend",
    "gcp:prepare": "npm run gcp:prepare:backend && npm run gcp:prepare:frontend",
    "gcp:prepare:backend": "rimraf gcp/backend/dist gcp/backend/package.json gcp/backend/package-lock.json && cpy 'backend/dist/**' gcp/backend/dist && cpy backend/package.json backend/package-lock.json gcp/backend --flat",
    "gcp:prepare:frontend": "rimraf gcp/frontend/dist && cpy 'frontend/dist/**' gcp/frontend/dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "espree": "^11.2.0",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
